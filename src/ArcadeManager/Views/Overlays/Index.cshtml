@{
    ViewData["title"] = Localizer["OVERLAYS_INDEX_PAGETITLE"];
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="navmenu">@Localizer["HOME"]</a></li>
        <li class="breadcrumb-item active" aria-current="page">@Localizer["BREADCRUMB_OVERLAYS_INDEX"]</li>
    </ol>
</nav>

<h2>
    @Html.Raw(Localizer["OVERLAYS_INDEX_PAGETITLE"])
</h2>

<p>
    @Html.Raw(Localizer["OVERLAYS_INDEX_INTRO"])
</p>

<div class="list-group">
    <a asp-controller="Overlays" asp-action="Install" class="navmenu list-group-item list-group-item-action text-primary" id="overlaysMenuEntry">
        <i class="icustom-download"></i> @Localizer["OVERLAYS_INDEX_INSTALL"]
    </a>
    <a asp-controller="Overlays" asp-action="Check" class="navmenu list-group-item list-group-item-action text-primary">
        <i class="icon-search"></i> @Localizer["OVERLAYS_INDEX_CHECK"]
    </a>
    <a asp-controller="Overlays" asp-action="Generate" class="navmenu list-group-item list-group-item-action text-primary">
        <i class="icon-cogs"></i> @Localizer["OVERLAYS_INDEX_GENERATE"]
    </a>
    <a asp-controller="Overlays" asp-action="ConvertMameToRa" class="navmenu list-group-item list-group-item-action text-primary">
        <i class="icon-shuffle"></i> @Html.Raw(Localizer["OVERLAYS_INDEX_CONVERT_MAMETORA"])
    </a>
    <a asp-controller="Overlays" asp-action="ConvertRaToMame" class="navmenu list-group-item list-group-item-action text-primary">
        <i class="icon-shuffle"></i> @Html.Raw(Localizer["OVERLAYS_INDEX_CONVERT_RATOMAME"])
    </a>
</div>

@section Scripts {
<script>
$(() => {
    // check that an OS has been selected
    getOs((os) => {
        if (os === 'none' || os === 'batocera') {
            // disable overlays entry if no OS has been selected
            $('#overlaysMenuEntry')
                .removeClass('text-primary')
                .addClass('bg-light text-muted')
                .attr('href', '@Url.Action("KnownSystems", "Help")');
        }
    });
});
</script>
}
